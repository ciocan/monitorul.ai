{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "restriction": "off",
    "style": "off"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/no-array-index-key": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_source", "_index", "_id", "_score", "_meta", "_shards", "_msearch"]
      }
    ]
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["node_modules", ".next", "out", "dist", "build", "next-env.d.ts"]
}
