# Validated at startup by src/env.ts. Missing/malformed values fail the build.

# --- Required ----------------------------------------------------------------
ES_URL=
ES_API_KEY=

# --- Optional ----------------------------------------------------------------
# Set to 1 only when ES has a public TLS chain. Self-signed (default
# monitorul-ii box) leaves it unset.
ES_VERIFY_CERTS=

# Embed provider for hybrid (RRF) search. `local` calls the FastAPI embedder
# at EMBED_URL (the monitorul-ii box). `cloud` calls a hosted OpenAI-compatible
# /v1/embeddings endpoint — used on Vercel where the local embedder is
# unreachable. Default: local. Toggle by flipping this single line; both sets
# of creds can stay populated.
EMBED_PROVIDER=local

# `local` provider — FastAPI service at this base URL (monitorul-ii embedder).
EMBED_URL=http://127.0.0.1:8000

# `cloud` provider — any OpenAI-compatible /v1/embeddings endpoint that serves
# BGE-M3 (1024-dim). The full URL with the /v1/embeddings path is fine; the
# client also accepts a base URL and appends /v1/embeddings.
EMBED_CLOUD_URL=
EMBED_CLOUD_TOKEN=
# Model id sent in the request payload. Override only if your provider names
# the BGE-M3 weights differently (e.g. `BAAI/bge-m3`).
EMBED_CLOUD_MODEL=bge-m3

# Set to 1 to write search telemetry into monitorul_query_log.
QUERY_LOG_WRITE=

# --- S3-compatible storage (Cloudflare R2 in prod) ---------------------------
# Source artefacts (PDF / MD / sidecar) live in a PRIVATE bucket. The Next.js
# server mints short-lived (5 min) presigned URLs and 302-redirects to them
# from /mo/<year>/<part>/<issue>/pdf — credentials never reach the browser.
# Leave all four blank in search-only deployments; the PDF button is hidden
# when the bucket isn't configured.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# R2 ignores the region but aws4fetch requires *something* in the SigV4
# string-to-sign. `auto` is what Cloudflare's docs recommend.
S3_REGION=auto

# --- Upstash Redis (MCP rate limiting) --------------------------------------
# The MCP server at /api/mcp/* applies a sliding-window rate limit per IP.
# Without these creds the limiter no-ops (open to abuse — only for dev).
# Free tier covers 10K commands/day, well above any realistic MCP traffic.
# Get them from https://console.upstash.com → "Redis" → "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Defaults to https://monitorul.ai when unset.
NEXT_PUBLIC_SITE_URL=https://monitorul.ai

# --- Dev-only ---------------------------------------------------------------
# Comma-separated host(s) `next dev` should accept for cross-origin asset
# requests (LAN IPs to test from another device, ngrok tunnels, etc.). Ignored
# by `next build` / `next start`.
ALLOWED_DEV_ORIGINS=192.168.1.177

# --- CI escape hatch ---------------------------------------------------------
# Set to 1 to bypass env validation (e.g. release-please dry runs).
SKIP_ENV_VALIDATION=
